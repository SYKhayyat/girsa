/target
**/*.rs.bk
*.pdb

# Corpus. Downloaded at first run, never committed — 2.2 GB from Sefaria plus a
# 3.4 GB local Otzaria tree (spec.md §2.3b).
/corpus/
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Downloaded libraries of seforim, and the trees generated from them.
# `tools/build-a-shelf.mjs` unpacks them here by default. Somebody else's
# seforim, gigabytes of them, and not this repository's to carry.
/libraries/
/otzaria_latest*
/otzarlib*

# Derived indices. Rebuildable by definition (spec.md §4.1).
/index/

# personal/ is tracked (force-added 2026-08-31). It holds the one thing no
# command can rebuild (spec.md §11): shelf arrangement, scans, OCR data,
# editorial corrections, user works. See restore.sh for recovery.

node_modules/
dist/
.gstack/

# The shell. `src-tauri/target` and `gen/` are build output; `public/dev` is
# real Gemara written by `girsa-app --example dev-fixtures` so the page can be
# looked at in a browser, and it is corpus text — see the note above.
/app/src-tauri/target/
/app/src-tauri/gen/
/app/public/dev/

# The test runner's build output. Rebuilt by `npm test` every run (app/test/run.mjs).
app/.tmp-test/

# One workspace, one lockfile. The shell is a member (see the root manifest);
# a stray lockfile here would be a second resolution of the same graph.
/app/src-tauri/Cargo.lock

# `nix develop` writes this, and it is **not** committed on purpose — the
# argument is in `tools/nixos-ci.sh` and again in `ci.yml`, and it is a good
# one: `nixpkgs` and `flake-utils` are named by branch so every run resolves
# their HEAD, which is how the `nixos` job notices a package renamed out from
# under it. A lock file turns that into a silence lasting until somebody
# remembers to refresh it.
#
# So it is ignored rather than absent — the same decision, without the file
# showing up as untracked every time somebody enters the dev shell.
/flake.lock
