/target
**/*.rs.bk
*.pdb

# Corpus. Downloaded at first run, never committed — 2.2 GB from Sefaria plus a
# 3.4 GB local Otzaria tree (spec.md §2.3b).
/corpus/
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Downloaded libraries of seforim, and the trees generated from them.
# `tools/build-a-shelf.mjs` unpacks them here by default. Somebody else's
# seforim, gigabytes of them, and not this repository's to carry.
/libraries/
/otzaria_latest*
/otzarlib*

# Derived indices. Rebuildable by definition (spec.md §4.1).
/index/

# The personal layer: how the shelf was arranged, and the seforim somebody
# added. Not derived, not the corpus, and not anybody else's — the one thing
# here that no command can rebuild (spec.md §11).
/personal/

node_modules/
dist/
.gstack/

# The shell. `src-tauri/target` and `gen/` are build output; `public/dev` is
# real Gemara written by `girsa-app --example dev-fixtures` so the page can be
# looked at in a browser, and it is corpus text — see the note above.
/app/src-tauri/target/
/app/src-tauri/gen/
/app/public/dev/

# The test runner's build output. Rebuilt by `npm test` every run (app/test/run.mjs).
app/.tmp-test/

# One workspace, one lockfile. The shell is a member (see the root manifest);
# a stray lockfile here would be a second resolution of the same graph.
/app/src-tauri/Cargo.lock
