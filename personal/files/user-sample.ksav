#שער[מערכת כְּתָב]
#תת_שער[כתיבה עברית על גבי Typst אמיתי]

#קו_מפריד

#כותרת1[מבוא]

זהו מסמך לדוגמה המדגים כתיבה בעברית באמצעות פקודות עבריות בלבד. כל פקודה כאן היא #הדגשה[פונקציית Typst אמיתית], ולכן #נטוי[הקינון בלתי מוגבל] עובד מאליו — הקומפיילר של Typst הוא שמרנדר.

#כותרת2[רשימות עם קינון עמוק]

#רשימה(
  פריט[פריט ראשון פשוט.],
  פריט[
    פריט שני, ובתוכו #הדגשה[רשימה ממוספרת] מקוננת:
    #ממוספרת(
      פריט[שלב א],
      פריט[שלב ב, עם #קו_תחתון[הדגשה] והערת שוליים#הערה[הערה בתוך פריט בתוך רשימה — קינון חוצה.]],
    )
  ],
  פריט[
    פריט שלישי ובו #הדגשה[כותרת בתוך פריט]:
    #כותרת3[כותרת מקוננת בתוך רשימה]
    וגם טבלה קטנה:
    #טבלה(
      עמודות: 2,
      כותרת_תא[עמודה א], כותרת_תא[עמודה ב],
      תא[ערך 1], תא[ערך 2],
    )
  ],
)

#כותרת2[טבלה עם הערה ובתוכה טבלה נוספת]

#טבלה(
  עמודות: 3,
  כותרת_תא[מונח], כותרת_תא[הסבר], כותרת_תא[מקור],
  תא[קינון], תא[הכלה של מבנה בתוך מבנה], תא[ראה הערה#הערה[
    טבלה בתוך הערת שוליים בתוך תא של טבלה:
    #טבלה(עמודות: 2, תא[פנימי א], תא[פנימי ב], תא[1], תא[2])
  ]],
  תא[יישור], תא[#מרכז[ממורכז] מול #שמאל[Left]], תא[—],
)

#כותרת1[עיצוב מותאם]

אפשר לשלב #צבע(rgb("#b91c1c"))[טקסט צבעוני], #גדול[טקסט גדול], #קטן[טקסט קטן], ו־#גופן_שונה("David Libre")[גופן דוד]. כל אלו פקודות עבריות שקופות.
